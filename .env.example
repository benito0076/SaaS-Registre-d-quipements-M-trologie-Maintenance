# --- Application ---
# URL publique utilisée dans les QR codes et les e-mails (sans slash final)
APP_URL=http://localhost:3000

# --- Base de données (Supabase / Neon / PostgreSQL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/registre

# --- Authentification (Auth.js / NextAuth v5) ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# --- Stockage des certificats (S3 / Cloudflare R2 / Supabase Storage S3) ---
# "s3" en production, "local" pour le développement (fichiers dans .uploads/)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
# Pour R2 : https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- E-mails (Resend) ---
# Sans clé, les e-mails sont écrits dans les logs (mode développement)
RESEND_API_KEY=
EMAIL_FROM="Registre Métrologie <alertes@example.com>"

# --- Cron ---
# Vercel Cron envoie automatiquement "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=change-me

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prix récurrent 49 €/mois du plan Pro (price_...)
STRIPE_PRO_PRICE_ID=
